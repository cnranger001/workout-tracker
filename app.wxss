page {
  /* ---------- 主题变量 ----------
     下面两段由 tools/gen-theme-css.js 从 utils/theme.js 生成，改色值请改 theme.js，
     不要手改这两段（会被下次生成覆盖）。 */
  /* @theme-default:start */
  /* 默认 = 柠檬黄（没设置过主题时的兜底，与 .theme-lemon 完全一致） */
  --brand: #FFC300;
  --brand-2: #FFD84D;
  --brand-deep: #E0A100;
  --brand-text: #8A6500;
  --brand-ink: #3A2F00;
  --brand-soft: #FFF6D0;
  --brand-soft-2: #FBF5DC;
  --brand-shadow: rgba(224,161,0,0.32);
  --bg: #FAF8EF;
  --card: #FFFFFF;
  --line: #F0EDE0;
  --text-1: #221F15;
  --text-2: #55514A;
  --text-3: #A69F8E;
  --arrow: #C9C3B2;
  --fill: #F4F2E8;
  --fill-2: #F7F5EC;
  --ink-85: rgba(58,47,0,0.85);
  --ink-62: rgba(58,47,0,0.62);
  --ink-55: rgba(58,47,0,0.55);
  --ink-45: rgba(58,47,0,0.45);
  --ink-35: rgba(58,47,0,0.35);
  --ink-16: rgba(58,47,0,0.16);
  /* @theme-default:end */

  /* 圆角不随主题变 */
  --radius: 20rpx;

  background: var(--bg);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ---------- 主题类 ----------
   页面根节点带上 .theme-xxx，变量覆盖向下继承；
   页面内部所有样式只引用变量，所以换主题不需要动任何布局。 */
/* @theme-classes:start */
.theme-lemon {   /* 柠檬黄 · 默认 */
  --brand: #FFC300;
  --brand-2: #FFD84D;
  --brand-deep: #E0A100;
  --brand-text: #8A6500;
  --brand-ink: #3A2F00;
  --brand-soft: #FFF6D0;
  --brand-soft-2: #FBF5DC;
  --brand-shadow: rgba(224,161,0,0.32);
  --bg: #FAF8EF;
  --card: #FFFFFF;
  --line: #F0EDE0;
  --text-1: #221F15;
  --text-2: #55514A;
  --text-3: #A69F8E;
  --arrow: #C9C3B2;
  --fill: #F4F2E8;
  --fill-2: #F7F5EC;
  --ink-85: rgba(58,47,0,0.85);
  --ink-62: rgba(58,47,0,0.62);
  --ink-55: rgba(58,47,0,0.55);
  --ink-45: rgba(58,47,0,0.45);
  --ink-35: rgba(58,47,0,0.35);
  --ink-16: rgba(58,47,0,0.16);
}

.theme-sky {   /* 天蓝 · 清爽 */
  --brand: #5CB3E6;
  --brand-2: #8FD1F5;
  --brand-deep: #3E93C7;
  --brand-text: #176A96;
  --brand-ink: #0A3B55;
  --brand-soft: #E8F4FD;
  --brand-soft-2: #DDF0FC;
  --brand-shadow: rgba(62,147,199,0.32);
  --bg: #F4F9FC;
  --card: #FFFFFF;
  --line: #E3EFF6;
  --text-1: #16242B;
  --text-2: #4C5A63;
  --text-3: #97A6B0;
  --arrow: #BFD0DA;
  --fill: #ECF2F6;
  --fill-2: #F3F8FB;
  --ink-85: rgba(10,59,85,0.85);
  --ink-62: rgba(10,59,85,0.62);
  --ink-55: rgba(10,59,85,0.55);
  --ink-45: rgba(10,59,85,0.45);
  --ink-35: rgba(10,59,85,0.35);
  --ink-16: rgba(10,59,85,0.16);
}

