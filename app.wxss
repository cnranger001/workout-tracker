  --bg: #F6F8F0;
  --card: #FFFFFF;
  --line: #E5EAD9;
  --text-1: #1E2217;
  --text-2: #4E5344;
  --text-3: #9AA189;
  --arrow: #C2C9B2;
  --fill: #EFEFE7;
  --fill-2: #F4F5EC;
