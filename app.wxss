/* @theme-classes:end */

.page {
  padding: 24rpx 24rpx 60rpx;
  /* 铺满整屏，换主题时页面底色跟着变；内容更长时可正常滚动 */
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

/* ---------- 通用卡片 ---------- */
.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 27, 12, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 20rpx;
}

.card-title .sub {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 12rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
  opacity: 0.6;
}
.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  border: none;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--brand);
  color: var(--brand-ink);
}
.btn-ghost {
  background: var(--fill);
  color: var(--text-2);
}

/* ---------- 数值强调 ---------- */
.num {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}
.num-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 6rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 分享入口条（打卡页 / 统计页共用） ---------- */
.share-entry {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 22rpx var(--brand-shadow);
}
.share-entry-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.share-entry-bd {
  flex: 1;
}
.share-entry-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.share-entry-d {
  font-size: 22rpx;
  color: var(--ink-62);
  margin-top: 4rpx;
}
.share-entry-ar {
  font-size: 40rpx;
  color: var(--ink-55);
  line-height: 1;
}

/* ---------- 通用入口条（白底，与彩色分享条区分） ---------- */
.entry {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 27, 12, 0.04);
}
.entry-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.entry-bd {
  flex: 1;
}
.entry-t {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.entry-d {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.entry-ar {
  font-size: 40rpx;
  color: var(--text-3);
  line-height: 1;
}
