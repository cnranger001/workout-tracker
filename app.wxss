.theme-purple {   /* 紫 · 个性 */
  --brand: #7B5AD8;
  --brand-2: #9F86EE;
  --brand-deep: #6547BC;
  --brand-text: #5C3FB0;
  --brand-ink: #FDFBFF;
  --brand-soft: #F1ECFD;
  --brand-soft-2: #EAE2FB;
  --brand-shadow: rgba(101,71,188,0.32);
  --bg: #F8F6FE;
  --card: #FFFFFF;
  --line: #EBE5F8;
  --text-1: #201B2C;
  --text-2: #544D66;
  --text-3: #9E96B4;
  --arrow: #CFC7E4;
  --fill: #F1EEF7;
  --fill-2: #F6F3FC;
  --ink-85: rgba(253,251,255,0.85);
  --ink-62: rgba(253,251,255,0.62);
  --ink-55: rgba(253,251,255,0.55);
