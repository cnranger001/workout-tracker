  --brand-text: #6C675D;
  --brand-ink: #2A2823;
  --brand-soft: #F2F0EA;
  --brand-soft-2: #EAE7DF;
  --brand-shadow: rgba(139,133,120,0.32);
  --bg: #F7F6F2;
  --card: #FFFFFF;
  --line: #E7E4DC;
  --text-1: #22211D;
  --text-2: #55534C;
  --text-3: #A09C91;
  --arrow: #C8C3B6;
  --fill: #F0EFE9;
  --fill-2: #F5F4EF;
  --ink-85: rgba(42,40,35,0.85);
  --ink-62: rgba(42,40,35,0.62);
  --ink-55: rgba(42,40,35,0.55);
  --ink-45: rgba(42,40,35,0.45);
  --ink-35: rgba(42,40,35,0.35);
