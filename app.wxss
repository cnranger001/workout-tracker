  --brand-text: #8E2F3C;
  --brand-ink: #FFF6F5;
  --brand-soft: #F9EAEC;
  --brand-soft-2: #F3DDE0;
  --brand-shadow: rgba(116,35,44,0.32);
  --bg: #FAF6F6;
  --card: #FFFFFF;
  --line: #F1E2E4;
  --text-1: #241A1B;
  --text-2: #5A4A4C;
  --text-3: #A99094;
  --arrow: #DCC4C7;
  --fill: #F3EBEC;
