.sum-bar {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 27, 12, 0.04);
}
.sum-cell {
  flex: 1;
  text-align: center;
}
.sum-cell:first-child {
  border-right: 2rpx solid var(--line);
}
.sum-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #221F15;
  font-variant-numeric: tabular-nums;
}
.sum-label {
  font-size: 22rpx;
  color: #A69F8E;
  margin-top: 4rpx;
}

.day-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 27, 12, 0.04);
}
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.day-date {
  display: flex;
  align-items: baseline;
}
.day-main {
  font-size: 30rpx;
  font-weight: 600;
}
.day-week {
  font-size: 22rpx;
  color: #A69F8E;
  margin-left: 12rpx;
}
.day-right {
  display: flex;
  align-items: center;
}
.day-total {
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.day-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #A69F8E;
  margin-left: 4rpx;
}
.day-arrow {
  font-size: 36rpx;
  color: #C6C0AF;
  margin-left: 14rpx;
  transition: transform 0.2s;
}
.day-arrow.open {
  transform: rotate(90deg);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}
.chip {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip-num {
  font-weight: 700;
  margin-left: 10rpx;
}

.detail {
  margin-top: 8rpx;
  border-top: 2rpx solid var(--line);
  padding-top: 8rpx;
}
.set-row {
  display: flex;
  align-items: center;
  height: 60rpx;
  font-size: 25rpx;
  color: #55514A;
}
.s-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}
.s-icon-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}
.chip-img {
  width: 30rpx;
  height: 30rpx;
  margin-right: 6rpx;
}
.s-name {
  width: 150rpx;
  font-weight: 600;
}
.s-idx {
  width: 100rpx;
  color: #A69F8E;
  font-size: 22rpx;
}
.s-reps {
  width: 110rpx;
  font-weight: 600;
}
.s-weight {
  font-size: 22rpx;
  color: #A69F8E;
  margin-right: 10rpx;
}
.s-time {
  flex: 1;
  text-align: right;
  font-size: 22rpx;
  color: #C6C0AF;
}
.day-del {
  text-align: center;
  font-size: 24rpx;
  color: #E5484D;
  padding: 16rpx 0 4rpx;
}

.empty-btn {
  margin-top: 40rpx;
}
.empty-text {
  white-space: pre-line;
}
