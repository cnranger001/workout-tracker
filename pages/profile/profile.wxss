/* ---------------- 资料卡 ---------------- */
.prof-hero {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 22rpx var(--brand-shadow);
}

/* 微信头像填写能力必须用 button open-type，需要清掉默认样式 */
.avatar-btn {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  overflow: visible;
  flex-shrink: 0;
  line-height: normal;
}
.avatar-btn::after {
  border: none;
}
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  display: block;
}
.avatar-ph {
  background: rgba(255, 255, 255, 0.55);
  color: var(--brand-ink);
  font-size: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-cam {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(31, 27, 12, 0.18);
}

.prof-id {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}
.nick-input {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--brand-ink);
  height: 56rpx;
  line-height: 56rpx;
}
.nick-ph {
  color: var(--ink-45);
  font-weight: 400;
  font-size: 30rpx;
}
.prof-sub {
  font-size: 24rpx;
  color: var(--ink-62);
  margin-top: 10rpx;
}

.hint-bar {
  display: flex;
  align-items: center;
  background: var(--brand-soft);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 24rpx;
}
.hint-ic {
  font-size: 24rpx;
  margin-right: 12rpx;
}
.hint-t {
  font-size: 23rpx;
  color: var(--brand-text);
  line-height: 1.4;
}

/* ---------------- BMI ---------------- */
.bmi-card {
  display: flex;
  align-items: center;
}
.bmi-left {
  width: 240rpx;
  flex-shrink: 0;
  border-right: 2rpx solid var(--line);
  padding-right: 24rpx;
}
.bmi-label {
  font-size: 22rpx;
  color: var(--text-3);
}
.bmi-num {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  margin: 6rpx 0 10rpx;
}
.bmi-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}
.bmi-right {
  flex: 1;
  padding-left: 28rpx;
}
.bmi-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.bmi-row:last-child {
  margin-bottom: 0;
}
.bmi-k {
  font-size: 24rpx;
  color: var(--text-3);
}
.bmi-v {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

/* ---------------- 表单行 ---------------- */
.field-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.field-row:last-child {
  border-bottom: none;
}
.field-k {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}
.field-v {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  text-align: right;
}
.field-u {
  font-size: 24rpx;
  color: var(--text-3);
  margin-left: 8rpx;
  width: 40rpx;
}

/* 性别分段控件 */
.seg {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}
.seg-item {
  min-width: 88rpx;
  text-align: center;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--fill);
  margin-left: 10rpx;
  border-radius: 24rpx;
}
.seg-item.on {
  background: var(--brand);
  color: var(--brand-ink);
  font-weight: 600;
}

/* ---------------- 体重 ---------------- */
.w-add {
  display: flex;
  align-items: center;
  background: var(--fill-2);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.w-input {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}
.w-unit {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 0 20rpx 0 8rpx;
}
.w-btn {
  background: var(--brand);
  color: var(--brand-ink);
  font-size: 25rpx;
  padding: 10rpx 32rpx;
  border-radius: 28rpx;
}

.w-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.w-row:last-child {
  border-bottom: none;
}
.w-date {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2);
}
.w-today {
  font-size: 20rpx;
  color: var(--brand-text);
  background: var(--brand-soft);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
}
.w-kg {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
  width: 140rpx;
  text-align: right;
}
.w-kg-u {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  margin-left: 4rpx;
}
.w-diff {
  width: 110rpx;
  text-align: right;
  font-size: 24rpx;
}
.w-diff.up {
  color: #FF9F43;
}
.w-diff.down {
  color: #2BC48A;
}
.w-diff.flat {
  color: var(--text-3);
}
.w-del {
  width: 56rpx;
  text-align: right;
  font-size: 32rpx;
  color: var(--text-3);
}
.w-empty {
  font-size: 25rpx;
  color: var(--text-3);
  text-align: center;
  padding: 30rpx 0 10rpx;
}

/* ---------------- 数据格 ---------------- */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat-cell {
  width: 25%;
  text-align: center;
  padding: 8rpx 0;
}
.stat-n {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-1);
  font-variant-numeric: tabular-nums;
}
.stat-l {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

/* ---------------- 其它 ---------------- */
.danger {
  text-align: center;
  font-size: 26rpx;
  color: #E5484D;
  padding: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

/* ---------------- 主题外观 ---------------- */
.theme-grid {
  display: flex;
  flex-wrap: wrap;
}
.theme-cell {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 6rpx;
}
.theme-dot {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(31, 27, 12, 0.1);
  /* 选中态靠外圈描边，不改变尺寸，切换时不会跳动 */
  border: 3rpx solid transparent;
}
.theme-cell.on .theme-dot {
  border-color: var(--text-1);
}
.theme-tick {
  width: 22rpx;
  height: 11rpx;
  margin-top: -6rpx;
  /* 勾的颜色跟随主题墨色：浅色主题深勾、深色主题白勾，都看得清 */
  border-left: 4rpx solid var(--brand-ink);
  border-bottom: 4rpx solid var(--brand-ink);
  border-radius: 2rpx;
  transform: rotate(-45deg);
}
.theme-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.theme-cell.on .theme-name {
  color: var(--text-1);
  font-weight: 600;
}
