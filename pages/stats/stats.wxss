.grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  border-radius: 20rpx;
  padding: 12rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 27, 12, 0.04);
}
.grid-cell {
  width: 33.33%;
  text-align: center;
  padding: 24rpx 0;
}
.grid-num {
  font-size: 42rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.grid-num.hl {
  color: #FF9F43;
}
.grid-num.sm {
  font-size: 36rpx;
}
/* 容量类指标的单位：跟在数字后面，小一号，不抢数字的视觉重量 */
.grid-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #A69F8E;
  margin-left: 4rpx;
}
.grid-label {
  font-size: 22rpx;
  color: #A69F8E;
  margin-top: 4rpx;
}

.chart {
  width: 100%;
  display: block;
}
.chart-load {
  height: 250rpx;
}

/* 日K / 周K / 月K 切换：小圆角胶囊，选中填品牌色 */
.ktabs {
  display: flex;
  margin: -4rpx 0 10rpx;
}
.ktab {
  padding: 8rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: var(--fill);
  color: var(--text-3);
  font-size: 24rpx;
  line-height: 1.2;
}
.ktab.on {
  background: var(--brand);
  color: var(--brand-text);
  font-weight: 600;
}

.type-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.type-row:last-child {
  margin-bottom: 0;
}
.type-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
  margin-top: 4rpx;
}
.type-icon-img {
  width: 44rpx;
  height: 44rpx;
  margin-right: 18rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}
.type-body {
  flex: 1;
}
.type-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.type-name {
  font-size: 28rpx;
  font-weight: 600;
}
.type-num {
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.type-bar {
  height: 10rpx;
  background: var(--line);
  border-radius: 5rpx;
  overflow: hidden;
  margin: 12rpx 0 8rpx;
}
.type-fill {
  height: 100%;
  border-radius: 5rpx;
}
.type-sub {
  font-size: 22rpx;
  color: #A69F8E;
}
/* 累计吨数：比「单组最高」重要，加粗一档、颜色压深 */
.type-load {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
.type-dot {
  color: #C6C0AF;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #C6C0AF;
  padding: 8rpx 0 20rpx;
}
.empty-btn {
  margin-top: 40rpx;
}
.empty-text {
  white-space: pre-line;
}
