/* ---------- 项目列表 ---------- */
.ex-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--line);
}
.ex-row:first-of-type {
  border-top: none;
}
.ex-row.off {
  opacity: 0.5;
}
.ex-ic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.ex-bd {
  flex: 1;
}
.ex-nm {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}
.tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--brand-text);
  background: var(--brand-soft);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.tag.gray {
  color: var(--text-3);
  background: var(--fill);
}
.ex-go {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}
.ex-ar {
  font-size: 40rpx;
  color: var(--text-3);
  line-height: 1;
}

.fav-btn.on .fav-star {
  color: var(--brand-deep);
}

.tip {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.btn-block {
  display: flex;
  width: 100%;
}
.foot-tip {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  margin-top: 20rpx;
}

/* ---------- 弹层 ---------- */
.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(31, 27, 12, 0.45);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  transition: opacity 0.2s;
}
.mask.show {
  opacity: 1;
}
.sheet {
  width: 100%;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
  max-height: 84vh;
  overflow-y: auto;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 24rpx;
}
.inp {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  background: var(--fill-2);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
}
.sheet-label {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 28rpx 0 16rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}
.g-item {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: var(--fill-2);
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin: 0 14rpx 14rpx 0;
}
.g-item.on {
  border-color: var(--brand-text);
  background: var(--brand-soft);
}

/* 专属图标：列表头像内 & 选择器格内 */
.ex-img {
  width: 56rpx;
  height: 56rpx;
}
.g-img {
  width: 60rpx;
  height: 60rpx;
}

/* 推荐项目的一键添加按钮 */
.ex-add {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 24rpx;
}
.colors {
  margin-bottom: 8rpx;
}
.c-item {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  margin: 0 14rpx 14rpx 0;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}
.c-item.on {
  border-color: rgba(31, 27, 12, 0.25);
}

.sheet-row {
  display: flex;
  margin-top: 20rpx;
  border-top: 2rpx solid var(--line);
  padding-top: 20rpx;
}
.sheet-act {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 16rpx 0;
}
.sheet-act.danger {
  color: #E5484D;
}

.sheet-btns {
  display: flex;
  margin-top: 24rpx;
}
.sbtn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 28rpx;
  background: var(--fill);
  color: var(--text-2);
}
.sbtn + .sbtn {
  margin-left: 20rpx;
}
.sbtn.ok {
  background: var(--brand);
  color: var(--brand-ink);
}
.sheet-note {
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  margin-top: 20rpx;
}

/* 每日目标输入行 */
.goal-row {
  display: flex;
  align-items: center;
}
.goal-inp {
  flex: 1;
  min-width: 0;
}
.goal-unit {
  flex: none;
  margin-left: 12rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* 自重比例调节 */
.label-note {
  margin-left: 12rpx;
  font-size: 21rpx;
  color: #B7B1A1;
}
.ratio-card {
  padding: 20rpx 22rpx 16rpx;
  background: var(--fill-2);
  border-radius: 16rpx;
}
.ratio-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.ratio-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--brand-text);
  font-variant-numeric: tabular-nums;
}
.ratio-each {
  font-size: 22rpx;
  color: var(--text-3);
}
.ratio-each.warn {
  color: #C2781B;
}
.ratio-slider {
  margin: 12rpx 0 0;
}
.ratio-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 21rpx;
  color: #A69F8E;
}
.ratio-reset {
  color: var(--brand-text);
  padding: 6rpx 0 6rpx 16rpx;
}

/* ---------- 项目分组 ---------- */
.grp-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--line);
}
.grp-row:first-of-type {
  border-top: none;
}
.grp-idx {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 18rpx;
}
.grp-bd {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
}
.grp-nm {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  max-width: 260rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.grp-cnt {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.grp-ar {
  flex: none;
  font-size: 40rpx;
  color: var(--text-3);
  line-height: 1;
}
.grp-add {
  margin-top: 16rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 14rpx;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 26rpx;
  font-weight: 600;
}
.grp-max {
  margin-top: 16rpx;
}

/* 项目列表上方的分组筛选 chips，以及编辑弹层里的分组选择器 */
.grp-filter,
.grp-pick {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0 8rpx;
}
.grp-chip {
  flex: none;
  padding: 10rpx 24rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 999rpx;
  background: var(--fill-2);
  color: var(--text-2);
  font-size: 24rpx;
  border: 2rpx solid transparent;
}
.grp-chip.on {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand-text);
  font-weight: 600;
}
.grp-shown {
  margin: 0 0 8rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

/* 分组弹窗：复用项目编辑弹层的遮罩，改成居中卡片 */
.mask.center {
  align-items: center;
}
.group-modal {
  width: 580rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 20rpx 60rpx rgba(31, 27, 12, 0.25);
}
.group-modal .sheet-title {
  margin-bottom: 24rpx;
}
