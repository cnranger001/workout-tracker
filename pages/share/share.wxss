/* ================= 海报预览 ================= */
.poster {
  display: block;
  width: 100%;
  height: 517rpx;          /* 800:640 = 5:4 */
  border-radius: 20rpx;
  overflow: hidden;
}

/* ================= 分享日期 ================= */
.date-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  padding: 0 24rpx;
  background: var(--fill);
  border-radius: 16rpx;
}
.date-picker-text {
  font-size: 28rpx;
  color: var(--brand-text);
  font-weight: 600;
}
.date-picker-arrow {
  font-size: 40rpx;
  line-height: 1;
  color: #A69F8E;
}

/* ================= 小程序码状态 ================= */
.code-line {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #A69F8E;
}
.code-warn {
  color: #C2781B;
}

/* ================= 使用说明 ================= */
.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}
.step-no {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}
.step-t {
  flex: 1;
  font-size: 26rpx;
  color: #55514A;
  line-height: 1.6;
}
.step-note {
  font-size: 22rpx;
  color: #C6C0AF;
  line-height: 1.6;
  padding-top: 6rpx;
  border-top: 2rpx solid var(--line);
}

.btn-row {
  display: flex;
  margin-top: 8rpx;
}
.btn-flex {
  flex: 1;
  margin-right: 20rpx;
}
.btn-flex:last-child {
  margin-right: 0;
}

/* open-type="share" 的 button 需要抹掉原生按钮样式 */
.btn-share {
  line-height: 72rpx;
  padding: 0;
  font-size: 26rpx;
  font-weight: 400;
}
.btn-share::after {
  border: none;
}

.empty-btn {
  margin-top: 32rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #C6C0AF;
  padding: 24rpx 0;
}

/* ==========================================================
   朋友圈「单页模式」卡片
   该模式下顶部有固定导航栏、底部有操作栏，页面要能自洽
   ========================================================== */
.sp {
  padding: 8rpx 0 24rpx;
}
.sp-card {
  border-radius: 28rpx;
  padding: 40rpx 34rpx 34rpx;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  box-shadow: 0 12rpx 32rpx var(--brand-shadow);
  color: var(--brand-ink);
  overflow: hidden;
}

.sp-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.sp-brand {
  font-size: 34rpx;
  font-weight: 700;
}
.sp-date {
  font-size: 24rpx;
  color: var(--ink-62);
}
.sp-nick {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-85);
  margin-top: 4rpx;
}

.sp-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 40rpx;
}
.sp-hero-main {
  flex: 1;
  min-width: 0;
}
.sp-hero-label {
  font-size: 22rpx;
  color: var(--ink-62);
}
.sp-hero-num {
  font-size: 88rpx;
  font-weight: 700;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.sp-hero-unit {
  font-size: 28rpx;
  font-weight: 400;
  margin-left: 10rpx;
  color: var(--ink-55);
}
/* 组数：跟在次数下面，比次数再小一档 */
.sp-weight-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--ink-55);
  font-variant-numeric: tabular-nums;
}
.sp-weight {
  flex: none;
  margin-left: 20rpx;
  text-align: right;
}
.sp-weight-label {
  font-size: 20rpx;
  color: var(--ink-62);
}
.sp-weight-num {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}
.sp-weight-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-55);
}

/* 破纪录播报：占据原来俏皮话的位置 */
.sp-record {
  margin-top: 26rpx;
}
.sp-record-t {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--ink-85);
}

.sp-rows {
  margin-top: 34rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 22rpx;
  padding: 12rpx 24rpx;
}
.sp-row {
  display: flex;
  align-items: center;
  height: 66rpx;
}
.sp-name {
  flex: none;
  font-size: 26rpx;
  max-width: 46%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 目标肌群：项目名后面的小灰字，撑满中间剩余宽度，过长省略 */
.sp-muscle {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  margin-right: 28rpx;
  font-size: 20rpx;
  color: var(--ink-62);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 次数：夹在名称和重量之间，弱化成灰字（主次和打卡页一致：重量在前） */
.sp-val {
  flex: none;
  margin-right: 14rpx;
  font-size: 22rpx;
  color: var(--ink-62);
  font-variant-numeric: tabular-nums;
}
/* 没有训练量的项目（纯自重 / 0 负重）：次数自己顶到数值位，恢复加粗 */
.sp-val.solo {
  font-size: 28rpx;
  font-weight: 700;
  color: inherit;
}
/* 单项目总重量：数值列最右、加粗，做主数字 */
.sp-kg {
  flex: none;
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.sp-bottom {
  display: flex;
  margin-top: 22rpx;
}
.sp-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-right: 20rpx;
}
.sp-box:last-child {
  margin-right: 0;
}
.sp-box-label {
  font-size: 20rpx;
  color: var(--ink-55);
}
.sp-box-num {
  font-size: 42rpx;
  font-weight: 700;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}
.sp-box-unit {
  font-size: 22rpx;
  font-weight: 400;
  margin-left: 8rpx;
  color: var(--ink-62);
}

.sp-foot {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-45);
  margin-top: 30rpx;
}
