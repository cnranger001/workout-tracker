/* ---------- 日期栏 ---------- */
.date-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 27, 12, 0.04);
}
.date-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 44rpx;
  color: #55514A;
  background: var(--fill);
  border-radius: 50%;
}
.date-arrow.disabled {
  opacity: 0.3;
}
.date-main {
  flex: 1;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
}
.date-text {
  font-size: 30rpx;
  font-weight: 600;
}
.date-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  color: var(--brand-text);
}
.date-tag.back {
  background: var(--fill);
  color: #A69F8E;
}

/* ---------- 项目分组 tab ---------- */
.group-tabs {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 18rpx;
}
.group-tab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 26rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 27, 12, 0.04);
}
.group-tab.on {
  background: var(--brand);
  color: var(--brand-ink);
  font-weight: 600;
}
/* 分组内的项目数：选中态用半透明底，未选中用浅灰底 */
.group-tab-n {
  margin-left: 10rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  text-align: center;
  font-size: 20rpx;
  background: var(--fill);
  color: var(--text-3);
}
.group-tab.on .group-tab-n {
  background: rgba(255, 255, 255, 0.32);
  color: var(--brand-ink);
}
.group-note {
  margin: -6rpx 0 20rpx;
  padding-left: 8rpx;
  font-size: 21rpx;
  color: var(--text-3);
}
.empty-text {
  line-height: 1.7;
}

/* ---------- 概览 ---------- */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 22rpx var(--brand-shadow);
}
.hero-label {
  font-size: 24rpx;
  color: var(--ink-62);
}
.hero-num {
  font-size: 72rpx;
  font-weight: 700;
  color: var(--brand-ink);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
/* 换成吨带三位小数，字一多就收一档，别把右侧圆环挤出去 */
.hero-num.ton {
  font-size: 62rpx;
}
.hero-unit {
  font-size: 24rpx;
  font-weight: 400;
  margin-left: 8rpx;
  color: var(--ink-55);
}
.hero-weight {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}
.hero-weight-label {
  margin-right: 14rpx;
  font-size: 22rpx;
  color: var(--ink-55);
}
/* 次行：当日总次数，比总重量低一档，只作参考 */
.hero-weight-num {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--brand-ink);
  font-variant-numeric: tabular-nums;
}
.hero-weight-unit {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--ink-55);
}
.hero-sub {
  font-size: 22rpx;
  color: var(--ink-62);
  margin-top: 8rpx;
}
.hero-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 8rpx solid var(--ink-16);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ring-num {
  color: var(--brand-ink);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
/* 圆环里的「第 N」：第 是小一号的前缀，数字保持原来的字号 */
.ring-pre {
  font-size: 18rpx;
  font-weight: 500;
  color: var(--ink-55);
  margin-right: 2rpx;
  letter-spacing: 0;
}
/* 当天还没有记录：圆环里放一个破折号占位，别让圆看起来是空的 */
.ring-none {
  font-size: 30rpx;
  color: var(--ink-16);
  letter-spacing: 0;
}
/* 圆环下面的排名说明：历史第 N · 再做 X kg 进第 N-1 */
.rank-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--ink-62);
}

/* ---------- 运动卡片：大图标占两行 + 名称/部位/负重，第三行 拨轮 ---------- */
.ex-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 27, 12, 0.04);
}

/* 头部：左边图标（两行文字高），右边 名称·训练量 / 部位·负重 */
.ex-head {
  display: flex;
  align-items: center;
  min-height: 128rpx;
}
.ex-iconbox {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}
.ex-icon {
  font-size: 64rpx;
  line-height: 1;
}
.ex-icon-img {
  width: 104rpx;
  height: 104rpx;
}
/* 右侧文字区：第一行 名称 + 训练量，第二行 部位，第三行 负重 */
.ex-bd {
  flex: 1;
  min-width: 0;
}
.ex-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
}
/* 训练量与排名贴在名称右侧：两行小字右对齐，第一行和项目名同一基线 */
.ex-line-stat {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 58%;
  min-width: 0;
  margin-left: auto;
  padding-left: 12rpx;
}
.ex-name {
  flex: 0 1 auto;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #221F15;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 训练部位：紧跟在名称正下方，和推荐项目卡的副标题同字号同灰度 */
.ex-desc {
  display: block;
  margin-top: 2rpx;
  max-width: 100%;
  font-size: 22rpx;
  line-height: 1.2;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 「最近」角标：说明这张卡为什么排在最前 */
.ex-latest {
  display: inline-block;
  margin-left: 8rpx;
  padding: 0 8rpx;
  height: 26rpx;
  line-height: 26rpx;
  border-radius: 13rpx;
  background: var(--brand-soft);
  color: var(--brand-text);
  font-size: 18rpx;
  font-weight: 500;
  vertical-align: 2rpx;
}
/* 组数 · 总次数 + 训练量 + 展开箭头：跟在拨轮右侧，靠右对齐 */
.ex-meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  align-content: center;
  justify-content: flex-end;
  padding-left: 12rpx;
}
/* 组数 · 总次数：底部只留这一行小字和展开箭头 */
.ex-meta-t {
  flex: none;
  margin-left: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: #A69F8E;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
/* 项目当天训练量：品牌色加粗，和项目名同一行 */
.ex-load {
  flex: none;
  max-width: 100%;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-text);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
/* 历史排名与追赶差距：紧跟训练量下面，仍属于卡片顶部 */
.ex-rank {
  display: block;
  max-width: 100%;
  margin-top: 2rpx;
  text-align: right;
  font-size: 18rpx;
  font-weight: 400;
  color: #A69F8E;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 纯 CSS 箭头：小方块只留右、下两条边，转 45° 朝下；展开后转 -135° 朝上 */
.ex-meta-ic {
  width: 14rpx;
  height: 14rpx;
  margin: -7rpx 2rpx 0 8rpx;
  border-right: 3rpx solid var(--arrow);
  border-bottom: 3rpx solid var(--arrow);
  transform: rotate(45deg);
  transition: transform 0.18s ease, margin 0.18s ease;
}
.ex-meta-ic.open {
  margin-top: 7rpx;
  transform: rotate(-135deg);
}

/* ---------- 第三行：次数水平拨轮（窄版）+ 组数信息 + 对号记录 ---------- */
.log-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.wheel {
  position: relative;
  flex: none;
  width: 300rpx;
  height: 62rpx;
  overflow: hidden;
}
/* 选中窗：固定在中线上的一枚浅色胶囊，数字从它上面滚过 */
.wheel-window {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 72rpx;
  height: 52rpx;
  margin: -26rpx 0 0 -36rpx;
  border-radius: 18rpx;
  background: var(--brand-soft-2);
}
/* 轨道以容器中线为原点，靠 translateX 滚动，中心格永远落在中线上 */
.wheel-track {
  position: absolute;
  left: 50%;
  top: 0;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  will-change: transform;
}
.wheel-item {
  flex: none;
  width: 62rpx;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}
/* 中间格：最大最黑；越往左右两边越小越淡 */
.lv0 {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -2rpx;
  color: #221F15;
}
.lv1 {
  font-size: 23rpx;
  color: #B7B1A1;
}
.lv2 {
  font-size: 20rpx;
  color: #C8C2B2;
}
.lv3 {
  font-size: 17rpx;
  color: #DBD6C7;
}
.lv4 {
  font-size: 15rpx;
  color: #E8E3D6;
}
/* 左右渐隐，和卡片白底融为一体 */
.wheel-fade {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 62rpx;
  pointer-events: none;
}
.wheel-fade.left {
  left: 0;
  background: linear-gradient(90deg, #FFFFFF 22%, rgba(255, 255, 255, 0) 100%);
}
.wheel-fade.right {
  right: 0;
  background: linear-gradient(270deg, #FFFFFF 22%, rgba(255, 255, 255, 0) 100%);
}

/* 右侧：一颗对号按钮记一组；灰调，作为次要动作存在 */
.check-btn {
  flex: none;
  width: 42rpx;
  height: 42rpx;
  margin-left: 16rpx;
  border-radius: 50%;
  background: #8F897D;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(31, 27, 12, 0.12);
  transition: transform 0.12s ease, opacity 0.12s ease;
}
.check-btn:active {
  transform: scale(0.9);
  opacity: 0.9;
}
/* 纯 CSS 对号：左下两条边整体转 -45° */
.check-ico {
  width: 23rpx;
  height: 12rpx;
  margin-top: -4rpx;
  border-left: 4rpx solid #FFFFFF;
  border-bottom: 4rpx solid #FFFFFF;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

/* ---------- 名称下面那一行：本次负重（靠右，和上面的部位文案右对齐） ---------- */
.weight-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 10rpx;
}
/* 负重纪录提示：挤在「负重」标签左侧的剩余空间里，不额外占一行高度 */
.best-hint {
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  text-align: left;
  font-size: 20rpx;
  line-height: 1.2;
  color: var(--text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 还差多少公斤：最需要被看见，用主题色；追平/超出用绿色/红色区分 */
.best-hint.behind {
  color: var(--brand-text);
}
.best-hint.match {
  color: #2BC48A;
}
.best-hint.ahead {
  color: #E5484D;
}
.weight-label {
  flex: none;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #8F897D;
}
.weight-control {
  flex: none;
  display: flex;
  align-items: center;
  width: 180rpx;
  height: 56rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: var(--fill-2);
  border-radius: 14rpx;
}
.weight-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  text-align: right;
  font-size: 26rpx;
  color: #221F15;
  font-variant-numeric: tabular-nums;
}
.weight-unit {
  flex: none;
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #A69F8E;
}

/* ---------- 概览两栏（补回） ---------- */
.hero-left {
  flex: 1;
}
.hero-right {
  flex: none;
  margin-left: 24rpx;
}
.empty-btn {
  margin-top: 32rpx;
}

/* ---------- 组明细：默认折叠，点第一行展开 ---------- */
.set-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 10rpx;
}
.set-row {
  display: flex;
  align-items: center;
  width: 48.6%;
  height: 54rpx;
  margin-top: 10rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  background: var(--fill-2);
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #55514A;
  overflow: hidden;
  white-space: nowrap;
}
.set-index {
  flex: none;
  margin-right: 8rpx;
  color: #A69F8E;
}
/* 重量在前、加粗带项目色；次数退成灰字，主次和卡片第三行一致 */
.set-weight {
  flex: none;
  margin-right: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.set-reps {
  flex: none;
  margin-right: 8rpx;
  font-size: 20rpx;
  color: #A69F8E;
}
.set-time {
  flex: 1;
  text-align: right;
  color: #B7B1A1;
  font-size: 20rpx;
}
.set-del {
  flex: none;
  width: 40rpx;
  margin-left: 4rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1;
  color: #C6C0AF;
}
.set-del:active {
  color: #E5484D;
}

.foot-tip {
  margin: 8rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.7;
  color: #B7B1A1;
}

/* ---------- 添加一组的弹窗 ---------- */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(31, 27, 12, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
}
.mask.show {
  opacity: 1;
}
.modal {
  width: 580rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 28rpx;
  box-shadow: 0 20rpx 60rpx rgba(31, 27, 12, 0.25);
}
.modal-head {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}
.modal-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}
.modal-icon-img {
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #221F15;
}
.field {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: var(--fill-2);
  border-radius: 16rpx;
}
.field-label {
  flex: none;
  width: 88rpx;
  font-size: 26rpx;
  color: #55514A;
}
.field-input {
  flex: 1;
  min-width: 0;
  width: 100%;
  font-size: 30rpx;
  color: #221F15;
}
.field-unit {
  flex: none;
  font-size: 24rpx;
  color: #A69F8E;
}
.modal-best {
  margin: -2rpx 0 4rpx;
  padding-left: 8rpx;
  font-size: 22rpx;
  color: var(--brand-text);
}
.modal-btns {
  display: flex;
  margin-top: 28rpx;
}
.modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.modal-btn.cancel {
  background: var(--fill);
  color: #55514A;
  margin-right: 16rpx;
}
.modal-btn.ok {
  background: var(--brand);
  color: var(--brand-ink);
}

/* ---------- 记一组成功：撒花反馈（不拦截点击，动画结束自动移除） ---------- */
.confetti-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9999;
  overflow: hidden;
  pointer-events: none;
}
.confetti-bit {
  position: absolute;
  top: -40rpx;
  opacity: 0;
  animation-timing-function: linear;
  animation-fill-mode: both;
}
@keyframes cf-0 {
  0%   { opacity: 0; transform: translate3d(0, -40rpx, 0) rotate(0deg); }
  8%   { opacity: 1; }
  100% { opacity: 0; transform: translate3d(36rpx, 1350rpx, 0) rotate(680deg); }
}
@keyframes cf-1 {
  0%   { opacity: 0; transform: translate3d(0, -40rpx, 0) rotate(0deg); }
  8%   { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-48rpx, 1350rpx, 0) rotate(-720deg); }
}
@keyframes cf-2 {
  0%   { opacity: 0; transform: translate3d(0, -40rpx, 0) rotate(0deg); }
  8%   { opacity: 1; }
  100% { opacity: 0; transform: translate3d(76rpx, 1350rpx, 0) rotate(540deg); }
}
@keyframes cf-3 {
  0%   { opacity: 0; transform: translate3d(0, -40rpx, 0) rotate(0deg); }
  8%   { opacity: 1; }
  100% { opacity: 0; transform: translate3d(-84rpx, 1350rpx, 0) rotate(-560deg); }
}
.confetti-word {
  position: absolute;
  left: 50%;
  top: 46%;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(34, 31, 21, 0.86);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  animation: confetti-word 1.1s ease-out both;
}
@keyframes confetti-word {
  0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.7); }
  18%  { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  68%  { opacity: 1; transform: translate(-50%, -60%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -110%) scale(1); }
}
